{
  "version": "1.1.0",
  "name": "tictactoe-engine",
  "description": "A simple multiplayer game engine for Tic Tac Toe",
  "author": "Ender Puentes <endpuent@gmail.com>",
  "keywords": [
    "game",
    "engine",
    "socket.io",
    "typescript",
    "nodejs",
    "multiplayer",
    "multiplayer-game",
    "multiplayer-game-engine"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "nodemon --watch 'src/**/*.ts' --exec 'ts-node -r tsconfig-paths/register -r dotenv/config' src/server.ts",
    "start": "node -r tsconfig-paths/register -r dotenv/config dist/server.js",
    "lint": "eslint . --config eslint.config.mjs",
    "release": "release-it",
    "knip": "knip",
    "prepare": "husky",
    "format": "prettier --write src/**/*.ts"
  },
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.5.0",
    "eslint": "^9.25.1",
    "http": "0.0.1-security",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "@eslint/js": "^9.25.1",
    "@release-it/conventional-changelog": "^10.0.1",
    "@types/node": "^22.14.1",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "knip": "^5.52.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.5.3",
    "release-it": "^19.0.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.1"
  },
  "packageManager": "pnpm@10.8.0",
  "engines": {
    "node": "22.x",
    "pnpm": "10.x"
  },
  "main": "dist/src/server.js"
}
